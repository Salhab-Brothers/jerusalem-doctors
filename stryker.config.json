{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "lib/auth/**/*.ts",
    "lib/otp/**/*.ts",
    "lib/security/**/*.ts",
    "lib/api/**/*.ts",
    "lib/signup/**/*.ts",
    "proxy.ts",
    "!**/*.test.ts"
  ],
  "mutator": { "excludedMutations": ["StringLiteral"] },
  "ignoreStatic": true,
  "incremental": true,
  "reporters": ["clear-text", "html"],
  "clearTextReporter": { "reportScoreTable": true, "skipFull": true, "maxTestsToLog": 0, "allowColors": false },
  "thresholds": { "high": 85, "low": 78, "break": 75 },
  "ignorePatterns": [".next", ".worktrees", "coverage", ".env*", ".local-secrets", ".claude"],
  "tempDirName": ".stryker-tmp",
  "timeoutMS": 10000
}
